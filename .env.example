# ---------------------------------------------------------------------------
# Model backend. Any OpenAI-compatible endpoint works: OpenAI, Azure OpenAI,
# Groq, Together, OpenRouter, vLLM, Ollama (http://localhost:11434/v1), LM Studio.
# Leave OMNIFORGE_MOCK_LLM=true to run everything with no key at all.
# ---------------------------------------------------------------------------
OMNIFORGE_LLM_BASE_URL=https://api.openai.com/v1
OMNIFORGE_LLM_API_KEY=
OMNIFORGE_LLM_MODEL=gpt-4o-mini
OMNIFORGE_MOCK_LLM=true
OMNIFORGE_REQUEST_TIMEOUT=90

# ---------------------------------------------------------------------------
# Execution policy
# ---------------------------------------------------------------------------
OMNIFORGE_MAX_PARALLEL=4
OMNIFORGE_MAX_RETRIES=2
OMNIFORGE_RETRY_BASE_DELAY=0.4
OMNIFORGE_MAX_TASKS=40
OMNIFORGE_RUN_TIMEOUT=0
OMNIFORGE_FAIL_FAST=true

# ---------------------------------------------------------------------------
# Review loop (critic scores every output; weak output is reworked)
# ---------------------------------------------------------------------------
OMNIFORGE_REVIEW_ENABLED=true
OMNIFORGE_REVIEW_MIN_CHARS=40
OMNIFORGE_REVIEW_WITH_LLM=false
OMNIFORGE_MAX_REWORK=1

# ---------------------------------------------------------------------------
# Human approval gates
# ---------------------------------------------------------------------------
OMNIFORGE_REQUIRE_APPROVAL=false

# ---------------------------------------------------------------------------
# Cost control (0 disables the cap)
# ---------------------------------------------------------------------------
OMNIFORGE_BUDGET_TOKENS=0
OMNIFORGE_PRICE_IN=0
OMNIFORGE_PRICE_OUT=0

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------
# GitHub: reads work without a token (rate-limited); writes need repo scope.
GITHUB_TOKEN=
OMNIFORGE_GITHUB_BASE_URL=https://api.github.com

# ---------------------------------------------------------------------------
# Sandbox (off by default; process isolation + rlimits, not a container)
# ---------------------------------------------------------------------------
OMNIFORGE_ALLOW_CODE_EXEC=false
OMNIFORGE_SANDBOX_TIMEOUT=5
OMNIFORGE_SANDBOX_MEMORY_MB=256

# ---------------------------------------------------------------------------
# Identity, security and limits
# ---------------------------------------------------------------------------
# Multi-user mode: sessions, API keys, workspaces, RBAC. Off = single trusted user.
OMNIFORGE_AUTH_ENABLED=false
# Master key for the secrets vault (Fernet). Empty = a 0600 key file is created.
OMNIFORGE_SECRET_KEY=
OMNIFORGE_SESSION_TTL_HOURS=72
OMNIFORGE_RATE_LIMIT_PER_MINUTE=240
OMNIFORGE_RATE_LIMIT_BURST=60
OMNIFORGE_ALLOW_ANONYMOUS=false

# ---------------------------------------------------------------------------
# Model providers (openai | anthropic | gemini) and fallback chain
# ---------------------------------------------------------------------------
OMNIFORGE_LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# comma separated "provider:model" entries, tried in order after the primary
OMNIFORGE_LLM_FALLBACK=

# ---------------------------------------------------------------------------
# Mail (password reset, notices): console | smtp | off
# ---------------------------------------------------------------------------
OMNIFORGE_MAIL_BACKEND=console
OMNIFORGE_SMTP_HOST=
OMNIFORGE_SMTP_PORT=587
OMNIFORGE_SMTP_USER=
OMNIFORGE_SMTP_PASSWORD=
OMNIFORGE_SMTP_FROM=
OMNIFORGE_SMTP_TLS=true
OMNIFORGE_PUBLIC_BASE_URL=http://localhost:8000
OMNIFORGE_RESET_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Automation
# ---------------------------------------------------------------------------
OMNIFORGE_SCHEDULER_ENABLED=true
OMNIFORGE_SCHEDULER_TICK=5
OMNIFORGE_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Billing and quotas (USD per 1M tokens, "model:in:out,model2:in:out")
# ---------------------------------------------------------------------------
OMNIFORGE_USER_MONTHLY_TOKENS=0
OMNIFORGE_MODEL_PRICES=

# ---------------------------------------------------------------------------
# Plugins and content policy
# ---------------------------------------------------------------------------
OMNIFORGE_PLUGINS_ENABLED=true
OMNIFORGE_PLUGIN_ALLOW_UNSIGNED=true
OMNIFORGE_PLUGIN_PERMISSIONS=net.read,fs.write,github.read
OMNIFORGE_MODERATION_ENABLED=true
OMNIFORGE_MODERATION_LLM=false
OMNIFORGE_BLOCKED_TERMS=
OMNIFORGE_HTTP_ALLOWLIST=

# ---------------------------------------------------------------------------
# Retrieval, database, alerts
# ---------------------------------------------------------------------------
# Optional embeddings for semantic search (falls back to BM25 without a key)
OMNIFORGE_EMBEDDING_API_KEY=
OMNIFORGE_EMBEDDING_MODEL=text-embedding-3-small
# sqlite:///path/to.db today; postgres:// is planned (see core/pg.py)
OMNIFORGE_DB_URL=
OMNIFORGE_ALERT_EMAIL=
OMNIFORGE_ALERT_ON_FAILURE=true
OMNIFORGE_PLUGIN_REQUIRE_SIGNATURE=false

# ---------------------------------------------------------------------------
# Storage and API
# ---------------------------------------------------------------------------
OMNIFORGE_DATA_DIR=./data
OMNIFORGE_API_KEY=
OMNIFORGE_CORS_ORIGINS=
